<?xml version="1.0"?>
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui version="13" name="okular_shell" >
 <MenuBar>
  <Menu name="file" >
   <DefineGroup append="open_merge" name="file_open" />
   <DefineGroup append="save_merge" name="file_save" />
   <DefineGroup append="print_merge" name="file_print" />
   <Action name="file_new" append="open_merge" />
   <Action name="file_document_builder" append="open_merge" />
   <Action name="undo-close-tab" append="open_merge" />
  </Menu>
  <!--Menu name="view" >
   <Action name="fullscreen" />
  </Menu-->
  <Menu name="settings" >
   <DefineGroup append="show_merge" name="show_merge" />
   <DefineGroup append="configure_merge" name="configure_merge" />
  </Menu>
  <Merge/>
  <Menu name="help">
   <DefineGroup append="about_merge" name="about_merge" />
  </Menu>
 </MenuBar>
 <!-- Charta does not use a horizontal toolbar. Mark the toolbar of the
      standard GUI file (ui_standards.rc, which is merged in automatically
      by KXmlGuiWindow) as deleted so that it is not created at all. -->
 <ToolBar name="mainToolBar" noMerge="1" deleted="true"/>
 <ActionProperties scheme="Default">
 </ActionProperties>
</gui>
