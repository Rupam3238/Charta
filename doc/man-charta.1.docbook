<refentry lang="&language;">
<refentryinfo>
<title>Charta User's Manual</title>
<author><firstname>Yuri</firstname><surname>Chornoivan</surname>
<contrib>Charta man page.</contrib>
<email>yurchor@ukr.net</email></author>
