+void InkAnnotation::setAppearanceStream(const QByteArray &appearanceStream, const QRectF &boundingBox)
+{
+    Q_D(InkAnnotation);
+
+    if (!d->pdfAnnot) {
+        d->appearanceStream = appearanceStream;
+        d->appearanceBBox = boundingBox;
+        return;
+    }
+
+    const QRectF normalizedBBox = boundingBox.normalized();
+    const std::array<double, 4> bbox = {normalizedBBox.left(), normalizedBBox.top(), normalizedBBox.right(), normalizedBBox.bottom()};
+    static_cast<AnnotInk *>(d->pdfAnnot.get())->setAppearanceStream(appearanceStream.toStdString(), bbox);
+}
