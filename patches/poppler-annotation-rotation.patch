+void Annot::setUserRotation(double degreesCounterClockwise, double localWidth, double localHeight)
+{
+    annotLocker();
+
+    const bool hasLocalSize = std::isfinite(localWidth) && std::isfinite(localHeight) && localWidth > 0 && localHeight > 0;
+    const bool rotated = hasLocalSize && std::isfinite(degreesCounterClockwise) && std::abs(std::remainder(degreesCounterClockwise, 360.0)) > 1e-9;
+
+    // Keep the metadata even for line/ink annotations, whose native geometry
+    // already carries the rotation. It lets the editor restore the oriented
+    // frame after reopening.  A zero /ChartaRotate is meaningful when the
+    // frame angle equals the page orientation: without the local size the
+    // importer could not distinguish it from an annotation that was never
+    // rotated.
+    userRotation = rotated ? degreesCounterClockwise : 0;
+    userLocalWidth = localWidth;
+    userLocalHeight = localHeight;
+
+    if (hasLocalSize) {
+        update("ChartaRotate", Object(userRotation));
+        update("ChartaLocalW", Object(userLocalWidth));
+        update("ChartaLocalH", Object(userLocalHeight));
+        update("ChartaRotationV", Object(1));
+    } else {
+        update("ChartaRotate", Object::null());
+        update("ChartaLocalW", Object::null());
+        update("ChartaLocalH", Object::null());
+        update("ChartaRotationV", Object::null());
+    }
+
+    const bool nativeGeometry = type == typeLine || type == typePolyLine || type == typePolygon || type == typeInk;
+    if (nativeGeometry) {
+        appearanceHasUserRotation = false;
+        return;
+    }
+
+    const bool wrappedAppearance = type == typeFreeText || type == typeSquare || type == typeCircle || type == typeStamp;
+    if (!wrappedAppearance) {
+        return;
+    }
+
+    if (!rotated) {
+        if (appearanceHasUserRotation) {
+            const double centerX = (rect->x1 + rect->x2) / 2.0;
+            const double centerY = (rect->y1 + rect->y2) / 2.0;
+            setRectKeepAppearance(centerX - localWidth / 2.0, centerY - localHeight / 2.0, centerX + localWidth / 2.0, centerY + localHeight / 2.0);
+            invalidateAppearance();
+            generateAppearance();
+        }
+        appearanceHasUserRotation = false;
+        return;
+    }
+
+    // The appearance generators build the unrotated annotation into /Rect.
+    // Remember the rotated AABB centre, generate at the local size, then wrap
+    // the appearance and finally move /Rect to the rotated AABB.
+    const double centerX = (rect->x1 + rect->x2) / 2.0;
+    const double centerY = (rect->y1 + rect->y2) / 2.0;
+
+    setRectKeepAppearance(centerX - localWidth / 2.0, centerY - localHeight / 2.0, centerX + localWidth / 2.0, centerY + localHeight / 2.0);
     invalidateAppearance();
+    appearanceHasUserRotation = false;
+    generateAppearance();
+
+    if (appearance.isNull()) {
+        return;
+    }
+
+    rotateAppearance(degreesCounterClockwise);
+
+    const double radians = degreesCounterClockwise * M_PI / 180.0;
+    const double c = std::abs(std::cos(radians));
+    const double s = std::abs(std::sin(radians));
+    const double rotatedWidth = c * localWidth + s * localHeight;
+    const double rotatedHeight = s * localWidth + c * localHeight;
+
+    setRectKeepAppearance(centerX - rotatedWidth / 2.0, centerY - rotatedHeight / 2.0, centerX + rotatedWidth / 2.0, centerY + rotatedHeight / 2.0);
+}
+
+void Annot::rotateAppearance(double degreesCounterClockwise)
+{
+    if (appearance.isNull()) {
+        return;
+    }
+
+    Object appearanceObject = appearance.fetch(doc->getXRef());
+    if (!appearanceObject.isStream()) {
+        return;
+    }
+
+    Dict *appearanceDict = appearanceObject.getStream()->getDict();
+    const Object bboxObject = appearanceDict->lookup("BBox");
+    if (!bboxObject.isArrayOfLength(4)) {
+        return;
+    }
+
+    const double bbox[4] = { bboxObject.arrayGet(0).getNumWithDefaultValue(0), bboxObject.arrayGet(1).getNumWithDefaultValue(0), bboxObject.arrayGet(2).getNumWithDefaultValue(0), bboxObject.arrayGet(3).getNumWithDefaultValue(0) };
+
+    double matrix[6] = { 1, 0, 0, 1, 0, 0 };
+    const Object matrixObject = appearanceDict->lookup("Matrix");
+    if (matrixObject.isArrayOfLength(6)) {
+        for (int i = 0; i < 6; ++i) {
+            matrix[i] = matrixObject.arrayGet(i).getNumWithDefaultValue(matrix[i]);
+        }
+    }
+
+    // Transform the four BBox corners through the appearance Matrix.  The
+    // wrapper rotates those already-transformed corners around the origin;
+    // the translation below then moves the rotated bounding box to (0, 0).
+    // Rotating around the bbox centre and then applying a translation derived
+    // from the centre-relative corners would draw the appearance offset by the
+    // original centre (only a quarter of the appearance stayed inside the
+    // wrapper BBox).
+    const double corners[4][2] = { { bbox[0], bbox[1] }, { bbox[2], bbox[1] }, { bbox[2], bbox[3] }, { bbox[0], bbox[3] } };
+    double transformed[4][2];
+    for (int i = 0; i < 4; ++i) {
+        transformed[i][0] = matrix[0] * corners[i][0] + matrix[2] * corners[i][1] + matrix[4];
+        transformed[i][1] = matrix[1] * corners[i][0] + matrix[3] * corners[i][1] + matrix[5];
+    }
+
+    const double radians = degreesCounterClockwise * M_PI / 180.0;
+    const double c = std::cos(radians);
+    const double s = std::sin(radians);
+
+    double minX = std::numeric_limits<double>::max();
+    double minY = std::numeric_limits<double>::max();
+    double maxX = std::numeric_limits<double>::lowest();
+    double maxY = std::numeric_limits<double>::lowest();
+    for (int i = 0; i < 4; ++i) {
+        const double rx = c * transformed[i][0] - s * transformed[i][1];
+        const double ry = s * transformed[i][0] + c * transformed[i][1];
+        minX = std::min(minX, rx);
+        minY = std::min(minY, ry);
+        maxX = std::max(maxX, rx);
+        maxY = std::max(maxY, ry);
+    }
+
+    const double width = maxX - minX;
+    const double height = maxY - minY;
+    if (width <= 0 || height <= 0) {
+        return;
+    }
+
+    const double tx = -minX;
+    const double ty = -minY;
+
+    std::string content;
+    content += "q\n";
+    content += GooString::format("{0:.8f} {1:.8f} {2:.8f} {3:.8f} {4:.8f} {5:.8f} cm\n", c, s, -s, c, tx, ty);
+    content += "/ChartaOrig Do\n";
+    content += "Q\n";
+
+    // Copy the original appearance into a new indirect object.  setNewAppearance()
+    // invalidates the old /AP and removes its xref entries, so referring to the
+    // old stream by reference here would leave a dangling XObject.
+    const Ref originalAppearance = doc->getXRef()->addIndirectObject(appearanceObject);
+
+    auto xobjects = std::make_unique<Dict>(doc->getXRef());
+    xobjects->set("ChartaOrig", Object(originalAppearance));
+    auto resources = std::make_unique<Dict>(doc->getXRef());
+    resources->set("XObject", Object(std::move(xobjects)));
+
+    const std::array<double, 4> wrapperBBox = { 0, 0, width, height };
+    Object wrapper = createForm(content, wrapperBBox, false, std::move(resources));
+    setNewAppearance(std::move(wrapper));
+    appearanceHasUserRotation = true;
 }
 
